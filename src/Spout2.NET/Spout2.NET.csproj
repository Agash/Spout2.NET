<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Spout2.NET</RootNamespace>
    <!-- The shipped library runs the recommended rule set as errors; tests stay on the default set. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- IsAotCompatible only runs the analyzers on this project; this also checks that everything
         it references is annotated compatible. -->
    <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <IsPackable>true</IsPackable>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageId>Spout2.NET</PackageId>
    <Description>Spout for .NET: share video frames between Windows applications in real time as GPU textures from Direct3D 11, Direct3D 12 and OpenGL, compatible with OBS, Resolume, TouchDesigner and every other Spout 2 application. A managed implementation of the Spout protocol with no native dependencies. Native AOT compatible.</Description>
    <PackageTags>spout;spout2;windows;directx;d3d11;d3d12;opengl;texture;sharing;obs;video;capture;interop;gpu;nativeaot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DotNet.ReproducibleBuilds" PrivateAssets="all" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <!-- Source generator for the DXGI and D3D11 COM interop, in its AOT-safe form (NativeMethods.json). -->
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" />
    <InternalsVisibleTo Include="Spout2.NET.Tests" />
  </ItemGroup>
</Project>
